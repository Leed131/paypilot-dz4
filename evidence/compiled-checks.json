      "id": "CONV-H01",
      "scenario": "C-07 diagnostic variant: retain five case entities after a distraction block; explicit probes request the values.",
      "context": {
        "customer_id": "CUS-0004",
        "clock": "2026-09-15T10:00:00Z"
      },
      "turns": [
        {
          "role": "user",
          "content": "I'm CUS-0004. Transaction TX-0401, 240.00 EUR: the goods never arrived. Which reason code applies? State the transaction ID and amount too. Do not open a dispute."
        },
        {
          "role": "user",
          "content": "Can I dispute it? Use the official eligibility tool for that transaction and reason. State the transaction date, filing window in days, deadline, reason code and amount. Do not open a dispute."
        },
        {
          "role": "user",
          "content": "What is my daily outgoing transfer limit in EUR?"
        },
        {
          "role": "user",
          "content": "According to the tariff, what is the standard FX spread percentage for my tier? Give the percentage."
        },
        {
          "role": "user",
          "content": "Fine. Back to that charge — what do I do next? First state its exact transaction ID, amount and reason code. Do not open a dispute."
        },
        {
          "role": "user",
          "content": "240 euro, as I said at the start."
        },
        {
          "role": "user",
          "content": "And I still have time to file, right? State the original transaction's reason code, transaction date, filing window in days and filing deadline. Do not open a dispute."
        }
      ],
      "additional_metadata": {
        "layer": "memory",
        "oracle": "engine:disputes",
        "assertion": "dialog",
        "invariants": [
          {
